# ─── CLERK AUTHENTICATIE ──────────────────────────────────────────
# Haal deze op via dashboard.clerk.com > jouw app > API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxx

# Clerk redirect URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ─── DATABASE ─────────────────────────────────────────────────────
# PostgreSQL connectie string vanuit Coolify
# Formaat: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://mlcloud:JOUW_WACHTWOORD@localhost:5432/mlcloud_panel

# ─── APP ──────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://medewerkers.mlcloud.nl
NODE_ENV=production
